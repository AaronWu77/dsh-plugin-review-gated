{
  "name": "@aaronwu/dsh-review-gated",
  "version": "0.1.0-alpha.13",
  "description": "Review-gated development with approved execution, independent review and an integrated status panel.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronWu77/dsh-plugin-review-gated.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/workflow/controller.d.ts",
      "default": "./dist/workflow/controller.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./support": {
      "types": "./dist/storage/support.d.ts",
      "default": "./dist/storage/support.js"
    },
    "./journal": {
      "types": "./dist/storage/journal.d.ts",
      "default": "./dist/storage/journal.js"
    },
    "./permissions": {
      "types": "./dist/security/permissions.d.ts",
      "default": "./dist/security/permissions.js"
    },
    "./native-sandbox": {
      "types": "./dist/security/native.d.ts",
      "default": "./dist/security/native.js"
    },
    "./strict-sandbox": {
      "types": "./dist/security/strict-sandbox.d.ts",
      "default": "./dist/security/strict-sandbox.js"
    },
    "./role-guard": {
      "types": "./dist/security/role-guard.d.ts",
      "default": "./dist/security/role-guard.js"
    },
    "./native-runtime": {
      "types": "./dist/security/native-runtime.d.ts",
      "default": "./dist/security/native-runtime.js"
    },
    "./roles": {
      "types": "./dist/roles/runner.d.ts",
      "default": "./dist/roles/runner.js"
    },
    "./verification": {
      "types": "./dist/verification/runner.d.ts",
      "default": "./dist/verification/runner.js"
    },
    "./execution": {
      "types": "./dist/workflow/execution.d.ts",
      "default": "./dist/workflow/execution.js"
    },
    "./report": {
      "types": "./dist/workflow/report.d.ts",
      "default": "./dist/workflow/report.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./local-workspace": {
      "types": "./dist/security/local-workspace.d.ts",
      "default": "./dist/security/local-workspace.js"
    },
    "./tasks": {
      "types": "./dist/workflow/tasks.d.ts",
      "default": "./dist/workflow/tasks.js"
    },
    "./host-world": {
      "types": "./dist/security/host-world.d.ts",
      "default": "./dist/security/host-world.js"
    },
    "./team-board": {
      "types": "./dist/collaboration/team-board.d.ts",
      "default": "./dist/collaboration/team-board.js"
    },
    "./main-tools": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./ui/lib/types/client/index.d.ts",
      "default": "./ui/lib/client.js"
    },
    "./observed-ui": {
      "types": "./ui/lib/types/index.d.ts",
      "default": "./ui/lib/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "docs",
    "UPGRADE.md",
    "ui/README.md",
    "ui/README.zh.md",
    "ui/README.i18n.yaml",
    "ui/src",
    "ui/lib",
    "scripts/profile-migration.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "dev:link": "node scripts/link-dsh.mjs",
    "build": "tsc -p tsconfig.build.json && node ui/scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run --configLoader runner",
    "test:docs": "node scripts/check-docs.mjs",
    "test:card-layout": "pnpm build && node scripts/check-card-layout.mjs",
    "lint": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm test:docs && pnpm build",
    "test:integration": "pnpm build && vitest run tests/integration --configLoader runner",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "prepack": "pnpm build",
    "build:ui": "node ui/scripts/build.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "check:ui": "pnpm typecheck:ui && pnpm test:ui && node ui/scripts/check-candidate.mjs",
    "build:core": "tsc -p tsconfig.build.json",
    "typecheck:ui": "tsc -p ui/tsconfig.host.json --noEmit && tsc -p ui/tsconfig.client.json --noEmit"
  },
  "peerDependencies": {
