{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "dist/tsconfig.client.tsbuildinfo",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "react",
      "react-dom"
    ]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/css-modules.d.ts",
    "src/projection.ts",
    "src/summary.ts"
  ]
}
